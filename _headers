# Cloudflare Pages response headers. The ads embedded on itch.io (static/ads/) are loaded from itch's own pages and zoos.
/static/ads/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=600

# Allo (static/fonts/): fonts load cross-origin from the itch.io ads (static/ads/zoo-ad.js); the files never change in place.
/static/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
